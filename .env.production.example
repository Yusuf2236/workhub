# ==========================================
# WORKHUB PRODUCTION CONFIGURATION TEMPLATE
# ==========================================

# Database
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_NAME=workhub
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Backend & Security
# Both are REQUIRED. Generate with: openssl rand -hex 32
# IMPORTANT: if you previously ran with the old built-in default
# (workhub_sovereign_aes_256_gcm_secret_key_2026), set ONEID_ENCRYPTION_KEY to that
# exact value, otherwise already-encrypted PINFLs can no longer be decrypted.
JWT_SECRET=generate_a_random_64_character_string_here
# How long a login lasts; logout and password reset end sessions earlier
JWT_TTL=168h
ONEID_ENCRYPTION_KEY=generate_another_secret_64_character_encryption_key_here
APP_ENV=production

# OneID Integration (Uzbekistan Digital Government)
# QR authentication works automatically via id.egov.uz
# Official SSO web redirect credentials (optional, from Raqamli Hukumat / UZINFOCOM):
ONEID_CLIENT_ID=workhub
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=https://your-domain.uz/auth/oneid/callback
# QR sign-in uses undocumented id.egov.uz endpoints; set to false to hide it
ONEID_QR_ENABLED=true

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Frontend API URL (if serving directly without Nginx reverse proxy)
NEXT_PUBLIC_API_URL=

# Payments (Click / Payme). Paid plans are only activated by signed provider webhooks.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
# Shared secret for POST /api/v1/billing/webhook (sent in the X-Webhook-Secret header)
PAYMENT_WEBHOOK_SECRET=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Public site address (e.g. https://wzone.uz). Used in emailed links, Telegram posts,
# the sitemap and canonical vacancy URLs — set it in production.
PUBLIC_SITE_URL=

# Vacancy import from hh.uz (official API, area 97 = Uzbekistan).
# Register an application at https://dev.hh.ru, then set either the app token
# or the client id/secret pair. Without these, only manually posted vacancies appear.
HH_APP_TOKEN=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# hh requires a User-Agent naming your app and a contact, e.g. "WZone/1.0 (admin@your-domain.uz)"
HH_USER_AGENT=WZone/1.0
SCRAPER_INTERVAL=1m

# Extra allowed browser origins, comma separated (e.g. https://wzone.uz)
CORS_ALLOWED_ORIGINS=

# Outgoing email (verification and password reset links). Port 587 = STARTTLS, 465 = TLS.
# While SMTP is empty, no email is sent and posting vacancies does not require a verified email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WZone <noreply@your-domain.uz>

# nginx config: nginx.conf (HTTP) until the certificate exists, then nginx-https.conf
NGINX_CONF=nginx.conf

# Daily database dumps are written to ./backups and kept this many days
BACKUP_KEEP_DAYS=14
