PORT=8080
APP_ENV=development
JWT_SECRET=super-secret-key-for-local-development-only
ONEID_ENCRYPTION_KEY=local-development-encryption-key

# Local development helpers (ignored when APP_ENV=production)
# AUTH_MOCK_ENABLED=true   -> accept "mock-" Google tokens
# ONEID_DEMO_MODE=true     -> allow OneID login with a self-declared PINFL
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=workhub
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=workhub
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/workhub
STORAGE_USE_SSL=false

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@example.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_WEB_API_KEY=your-web-key

# Payments
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYMENT_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=http://localhost:3000/api/auth/callback/oneid

# Vacancy import from hh.uz (https://dev.hh.ru app credentials); sync runs every SCRAPER_INTERVAL
# HH_APP_TOKEN=
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_USER_AGENT=WZone/1.0 (admin@your-domain.uz)
# SCRAPER_INTERVAL=1m
